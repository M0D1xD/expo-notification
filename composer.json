{
    "name": "m0d1xd/expo-notification",
    "description": "Send Expo push notifications from Laravel and track delivery, opens and dismissals per device.",
    "keywords": [
        "laravel",
        "expo",
        "push-notifications",
        "expo-notifications",
        "analytics"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohammed Zakout",
            "email": "info@zakout.tech"
        }
    ],
    "homepage": "https://github.com/M0D1xD/expo-notification",
    "support": {
        "issues": "https://github.com/M0D1xD/expo-notification/issues",
        "source": "https://github.com/M0D1xD/expo-notification"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "filament/filament": "Adds the Push notifications section to Filament panels (ExpoNotificationPlugin, requires ^5.0)"
    },
    "conflict": {
        "filament/filament": "<5.0"
    },
    "autoload": {
        "psr-4": {
            "M0d1xd\\ExpoNotification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "M0d1xd\\ExpoNotification\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "M0d1xd\\ExpoNotification\\ExpoNotificationServiceProvider"
            ],
            "aliases": {
                "ExpoNotification": "M0d1xd\\ExpoNotification\\Facades\\ExpoNotification",
                "PushNotifier": "M0d1xd\\ExpoNotification\\Facades\\PushNotifier"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
